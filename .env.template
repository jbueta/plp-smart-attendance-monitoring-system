# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_monitoring
DB_PORT=3306
DB_POOL_SIZE=20
DB_AUTOCOMMIT=False

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_SECRET_KEY=replace_with_a_long_random_hex_value
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_HOURS=2

# JWT Configuration
JWT_SECRET=replace_with_a_second_long_random_hex_value
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=2

# Security Configuration
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=100/hour
CSRF_ENABLED=True
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SENDER_EMAIL=
SENDER_PASSWORD=

# Backend API Configuration
BACKEND_API_URL=http://127.0.0.1:5001
BACKEND_TIMEOUT=5
INSTANCE_GENERATOR_CHECK_SECONDS=60
INSTANCE_GENERATOR_RUN_INTERVAL_SECONDS=3600
INSTANCE_GENERATOR_LOOKAHEAD_DAYS=7

# Cache Configuration
CACHE_TYPE=SimpleCache
CACHE_TIMEOUT=600

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log
